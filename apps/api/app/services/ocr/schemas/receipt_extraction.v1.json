{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hem.local/schemas/receipt_extraction.v1.json",
  "title": "Receipt extraction v1",
  "type": "object",
  "required": ["schema_version", "supplier", "date", "total", "currency", "vat"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "v1"},
    "supplier": {"$ref": "#/$defs/text_field"},
    "date": {"$ref": "#/$defs/date_field"},
    "total": {"$ref": "#/$defs/money_field"},
    "vat": {"$ref": "#/$defs/money_field"},
    "currency": {"$ref": "#/$defs/currency_field"}
  },
  "$defs": {
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "text_field": {"type": "object", "required": ["value", "confidence"], "additionalProperties": false,
      "properties": {"value": {"type": ["string", "null"], "maxLength": 200}, "confidence": {"$ref": "#/$defs/confidence"}}},
    "date_field": {"type": "object", "required": ["value", "confidence"], "additionalProperties": false,
      "properties": {"value": {"type": ["string", "null"], "pattern": "^\\d{4}-\\d{2}-\\d{2}$"}, "confidence": {"$ref": "#/$defs/confidence"}}},
    "money_field": {"type": "object", "required": ["value", "confidence"], "additionalProperties": false,
      "properties": {"value": {"type": ["string", "null"], "pattern": "^\\d{1,10}\\.\\d{2}$"}, "confidence": {"$ref": "#/$defs/confidence"}}},
    "currency_field": {"type": "object", "required": ["value", "confidence"], "additionalProperties": false,
      "properties": {"value": {"type": ["string", "null"], "pattern": "^[A-Z]{3}$"}, "confidence": {"$ref": "#/$defs/confidence"}}}
  }
}
