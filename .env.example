# Copy to .env and change the secrets. Never commit .env.
APP_ENV=development
SECRET_KEY=change-me-to-a-long-random-string
POSTGRES_USER=hem
POSTGRES_PASSWORD=change-me
POSTGRES_DB=hem
DATABASE_URL=postgresql+psycopg://hem:change-me@db:5432/hem
REDIS_URL=redis://redis:6379/0
COOKIE_SECURE=false
STORAGE_BACKEND=s3
S3_ENDPOINT_URL=http://minio:9000
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=hem-minio
S3_SECRET_KEY=change-me-too
S3_BUCKET=hem-receipts
OCR_PROVIDER=rapidocr   # tesseract | rapidocr | azure_document | simulated | none
AZURE_DI_ENDPOINT=
AZURE_DI_KEY=
AZURE_DI_MODEL=prebuilt-receipt
PUBLIC_API_URL=
ADMIN_NAME=Financial Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-min-10-chars
